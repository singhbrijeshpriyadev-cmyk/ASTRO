# ==============================================================================
# KAALIKA OBSERVATORY — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local testing or configure these
# environment variables in your Cloud deployment platform (Vercel, Cloudflare, etc.)

# 1. Public Application URL (Never include trailing slash)
# Production Example: https://kaalika.pages.dev or https://kaalika.app
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://kaalika.pages.dev

# 2. Remote Cloud PostgreSQL Database Connection String (with SSL enabled)
# Compatible with Neon, Supabase, Railway, AWS RDS, etc.
# Example: postgresql://username:password@ep-proj-123456.us-east-1.aws.neon.tech/kaalika?sslmode=require
DATABASE_URL=postgresql://user:password@cloud-db-host.com:5432/kaalika?sslmode=require

# 3. Cryptographic Secret for Session & Authentication Tokens
# Generate a strong 32+ character key: openssl rand -base64 32
AUTH_SECRET=kaalika_production_super_secret_astronomical_key_32bytes_minimum

# 4. Environment Mode
NODE_ENV=production
